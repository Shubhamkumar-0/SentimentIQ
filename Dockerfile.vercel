
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src

COPY ConsultationSentimentProject.csproj ./
RUN dotnet restore ConsultationSentimentProject.csproj

COPY . ./
RUN dotnet publish ConsultationSentimentProject.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

WORKDIR /app

COPY --from=build /app/publish ./

ENV ASPNETCORE_ENVIRONMENT=Production

EXPOSE 80

CMD ["sh", "-c", "dotnet ConsultationSentimentProject.dll --urls http://0.0.0.0:${PORT:-80}"]
