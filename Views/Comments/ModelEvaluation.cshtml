@model ModelEvaluationReport
@{
    ViewData["Title"] = "ML.NET Model Evaluation & Benchmarks";
}

<div style="max-width: 1040px; margin: 0 auto;">
    <!-- Architecture Banner -->
    <div class="card" style="margin-bottom: 24px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
            <div>
                <span style="background: rgba(59, 130, 246, 0.2); color: #93c5fd; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase;">
                    Production AI Model
                </span>
                <h2 style="font-size: 22px; margin-top: 8px; color: #ffffff;">@Model.ModelName</h2>
                <p style="font-size: 13px; color: #94a3b8; margin-top: 4px;">
                    @Model.Notes
                </p>
            </div>
            <div style="text-align: right;">
                <div style="font-size: 11px; color: #94a3b8;">Trained & Evaluated</div>
                <strong style="font-size: 14px; color: #ffffff;">@Model.TrainedAt.ToString("dd MMM yyyy, hh:mm tt")</strong>
                <div style="font-size: 11px; color: #34d399; margin-top: 4px;">● ML Model Active & Calibrated</div>
            </div>
        </div>
    </div>

    <!-- Core Metrics Cards -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 24px;">
        <div class="card" style="padding: 18px;">
            <span class="kpi-title">Dataset Size</span>
            <div class="kpi-value">@Model.DatasetSize</div>
            <div class="kpi-subtext">Annotated consultation comments</div>
        </div>
        <div class="card" style="padding: 18px;">
            <span class="kpi-title">Micro Accuracy</span>
            <div class="kpi-value text-positive">@(Math.Round(Model.MicroAccuracy * 100, 1))%</div>
            <div class="kpi-subtext">Overall correct prediction rate</div>
        </div>
        <div class="card" style="padding: 18px;">
            <span class="kpi-title">Macro Accuracy</span>
            <div class="kpi-value text-positive">@(Math.Round(Model.MacroAccuracy * 100, 1))%</div>
            <div class="kpi-subtext">Unweighted average per class</div>
        </div>
        <div class="card" style="padding: 18px;">
            <span class="kpi-title">Cross-Entropy Log Loss</span>
            <div class="kpi-value text-neutral">@Model.LogLoss</div>
            <div class="kpi-subtext">Probability penalization metric</div>
        </div>
    </div>

    <!-- Per-Class Metrics Table -->
    <div class="card" style="margin-bottom: 24px;">
        <div class="card-header">
            <div>
                <h3 class="card-title">Per-Class Performance Metrics (Test Split)</h3>
                <p class="card-subtitle">Precision, Recall, and Harmonic Mean (F1-Score) for each sentiment classification class</p>
            </div>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Class Label</th>
                        <th>Precision</th>
                        <th>Recall</th>
                        <th>F1-Score</th>
                        <th>Support (Test Instances)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var metric in Model.PerClassMetrics.Values)
                    {
                        <tr>
                            <td>
                                <span class="pill @metric.ClassName.ToLowerInvariant()">
                                    @metric.ClassName
                                </span>
                            </td>
                            <td><strong>@(Math.Round(metric.Precision * 100, 1))%</strong></td>
                            <td><strong>@(Math.Round(metric.Recall * 100, 1))%</strong></td>
                            <td>
                                <strong style="color: #2563eb; font-size: 15px;">
                                    @(Math.Round(metric.F1Score * 100, 1))%
                                </strong>
                            </td>
                            <td>@metric.Support</td>
                            <td>
                                <span style="display: inline-flex; align-items: center; gap: 4px; color: #059669; font-size: 12px; font-weight: 600;">
                                    ✓ Optimal Convergence
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Confusion Matrix Card -->
    <div class="card" style="margin-bottom: 24px;">
        <div class="card-header">
            <div>
                <h3 class="card-title">Confusion Matrix (Multi-Class 3x3)</h3>
                <p class="card-subtitle">Actual Ground Truth (Rows) vs Model Predicted Sentiment (Columns)</p>
            </div>
        </div>

        <div style="max-width: 620px; margin: 0 auto; padding: 12px 0;">
            <table class="cm-table">
                <thead>
                    <tr>
                        <th style="background: transparent; border: none;"></th>
                        <th colspan="3" style="background: #f1f5f9; text-transform: uppercase; font-size: 11px; letter-spacing: 1px; color: #475569;">
                            Predicted Sentiment Class
                        </th>
                    </tr>
                    <tr>
                        <th style="background: #f1f5f9; text-transform: uppercase; font-size: 11px; letter-spacing: 1px; color: #475569; width: 140px;">
                            Actual Ground Truth
                        </th>
                        @foreach (var lbl in Model.ClassLabels)
                        {
                            <th style="width: 140px;">@lbl</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.ClassLabels.Length; i++)
                    {
                        <tr>
                            <td style="font-weight: 700; background: #f8fafc;">@Model.ClassLabels[i]</td>
                            @for (int j = 0; j < Model.ClassLabels.Length; j++)
                            {
                                int val = Model.ConfusionMatrix[i, j];
                                bool isDiagonal = (i == j);
                                string cellClass = isDiagonal ? (val > 0 ? "high" : "zero") : (val > 0 ? "error" : "zero");
                                <td class="cm-cell @cellClass">
                                    <div style="font-size: 16px;">@val</div>
                                    <span style="font-size: 10px; opacity: 0.8;">
                                        @(isDiagonal ? "True " + Model.ClassLabels[i] : "Misclassified")
                                    </span>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Technical Architecture & Theory Explanation for Interviews -->
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">System Architecture & NLP Engineering Design</h3>
                <p class="card-subtitle">Technical reference for project defense and faculty technical questions</p>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; font-size: 13px; line-height: 1.6; color: #334155;">
            <div>
                <h4 style="color: #0f172a; margin-bottom: 8px;">1. Text Preprocessing & Tokenization</h4>
                <p>
                    Raw feedback is first normalized by expanding English contractions (e.g., <em>wasn't &rarr; was not</em>, <em>don't &rarr; do not</em>) to prevent negation information loss. Punctuation boundaries are preserved to extract contrastive sub-clauses.
                </p>

                <h4 style="color: #0f172a; margin: 14px 0 8px;">2. Negation Handling & Scope Window</h4>
                <p>
                    A 3-token backward sliding window detects negation triggers (<em>not, never, no, without, hardly</em>). Polarity inversion takes place dynamically unless bounded by punctuation or contrastive conjunctions.
                </p>

                <h4 style="color: #0f172a; margin: 14px 0 8px;">3. Mixed Sentiment via Clause Segmentation</h4>
                <p>
                    Compound statements containing contrastive conjunctions (<em>but, however, although, yet, nevertheless</em>) are segmented into individual clauses. Conflicting polarities between clauses generate a <strong>Mixed</strong> classification while correctly attributing aspect scores to each respective clause.
                </p>
            </div>

            <div>
                <h4 style="color: #0f172a; margin-bottom: 8px;">4. ML.NET SDCA Classifier</h4>
                <p>
                    Trained using Microsoft ML.NET with <strong>Stochastic Dual Coordinate Ascent (SDCA) Maximum Entropy</strong>. Features are generated using n-gram text featurization with L1/L2 regularization and evaluated on an independent test split.
                </p>

                <h4 style="color: #0f172a; margin: 14px 0 8px;">5. Aspect-Based Extraction (ABSA)</h4>
                <p>
                    Identifies domain-specific dimensions: <em>Staff Behaviour</em>, <em>Waiting Time</em>, <em>Service Quality</em>, <em>Facilities</em>, and <em>Communication</em>. Matches triggers and calculates clause-level polarity and exact excerpt context.
                </p>

                <h4 style="color: #0f172a; margin: 14px 0 8px;">6. Calibrated Confidence Scoring</h4>
                <p>
                    Rather than pseudo-random numbers, confidence is calibrated by combining the Softmax normalized output of the ML.NET classifier with token support density and clause polarity certainty.
                </p>
            </div>
        </div>
    </div>
</div>
