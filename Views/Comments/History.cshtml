@model FeedbackHistoryViewModel
@{
    ViewData["Title"] = "Feedback Repository";
}

<!-- Filters & Search Toolbar -->
<div class="card" style="margin-bottom: 24px;">
    <form method="get" asp-action="History">
        <div class="filter-bar" style="border: none; padding: 0; margin-bottom: 0;">
            <div class="filter-field" style="flex: 2; min-width: 240px;">
                <label class="form-label">Search Feedback or User</label>
                <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search keywords (e.g. staff, waiting, doctor)..." />
            </div>

            <div class="filter-field">
                <label class="form-label">Sentiment</label>
                <select name="sentimentFilter" class="form-control">
                    <option value="All" selected="@(Model.SentimentFilter == "All" || string.IsNullOrEmpty(Model.SentimentFilter))">All Sentiments</option>
                    <option value="Positive" selected="@(Model.SentimentFilter == "Positive")">Positive</option>
                    <option value="Negative" selected="@(Model.SentimentFilter == "Negative")">Negative</option>
                    <option value="Neutral" selected="@(Model.SentimentFilter == "Neutral")">Neutral</option>
                    <option value="Mixed" selected="@(Model.SentimentFilter == "Mixed")">Mixed</option>
                </select>
            </div>

            <div class="filter-field">
                <label class="form-label">Aspect</label>
                <select name="aspectFilter" class="form-control">
                    <option value="All" selected="@(Model.AspectFilter == "All" || string.IsNullOrEmpty(Model.AspectFilter))">All Aspects</option>
                    <option value="Staff Behaviour" selected="@(Model.AspectFilter == "Staff Behaviour")">Staff Behaviour</option>
                    <option value="Waiting Time" selected="@(Model.AspectFilter == "Waiting Time")">Waiting Time</option>
                    <option value="Service Quality" selected="@(Model.AspectFilter == "Service Quality")">Service Quality</option>
                    <option value="Facilities" selected="@(Model.AspectFilter == "Facilities")">Facilities</option>
                    <option value="Communication" selected="@(Model.AspectFilter == "Communication")">Communication</option>
                </select>
            </div>

            <div class="filter-field">
                <label class="form-label">Date Range</label>
                <select name="dateRangeFilter" class="form-control">
                    <option value="All" selected="@(Model.DateRangeFilter == "All" || string.IsNullOrEmpty(Model.DateRangeFilter))">All Time</option>
                    <option value="Today" selected="@(Model.DateRangeFilter == "Today")">Today</option>
                    <option value="7Days" selected="@(Model.DateRangeFilter == "7Days")">Last 7 Days</option>
                    <option value="30Days" selected="@(Model.DateRangeFilter == "30Days")">Last 30 Days</option>
                </select>
            </div>

            <div class="filter-field">
                <label class="form-label">Sort By</label>
                <select name="sortOrder" class="form-control">
                    <option value="date_desc" selected="@(Model.SortOrder == "date_desc" || string.IsNullOrEmpty(Model.SortOrder))">Newest First</option>
                    <option value="date_asc" selected="@(Model.SortOrder == "date_asc")">Oldest First</option>
                    <option value="score_desc" selected="@(Model.SortOrder == "score_desc")">Highest Sentiment</option>
                    <option value="score_asc" selected="@(Model.SortOrder == "score_asc")">Lowest Sentiment</option>
                    <option value="confidence_desc" selected="@(Model.SortOrder == "confidence_desc")">Highest Confidence</option>
                </select>
            </div>

            <div style="display: flex; gap: 8px;">
                <button type="submit" class="btn btn-primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                    Apply Filter
                </button>
                <a asp-action="History" class="btn btn-secondary">Reset</a>
                <a asp-action="ExportCsv" 
                   asp-route-searchQuery="@Model.SearchQuery" 
                   asp-route-sentimentFilter="@Model.SentimentFilter" 
                   asp-route-aspectFilter="@Model.AspectFilter" 
                   asp-route-dateRangeFilter="@Model.DateRangeFilter" 
                   class="btn btn-secondary" title="Export current filtered view to CSV">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Export CSV
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Consultation Comments (@Model.TotalItems total)</h2>
            <p class="card-subtitle">Showing page @Model.CurrentPage of @Model.TotalPages</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New Comment</a>
    </div>

    @if (!Model.Comments.Any())
    {
        <div style="text-align: center; padding: 48px 0; color: #64748b;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" style="margin-bottom: 12px;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <h3>No feedback found matching the criteria</h3>
            <p style="margin-top: 6px;">Try adjusting your search keywords or resetting filters.</p>
            <a asp-action="History" class="btn btn-secondary btn-sm" style="margin-top: 14px;">Clear All Filters</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 50px;">ID</th>
                        <th>User Name</th>
                        <th style="min-width: 280px;">Comment Text</th>
                        <th>Sentiment</th>
                        <th>Confidence</th>
                        <th>Emotion</th>
                        <th>Aspect Breakdown</th>
                        <th>Date</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Comments)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td><strong>@item.UserName</strong></td>
                            <td>
                                <div>@item.CommentText</div>
                                @if (item.IsMixed)
                                {
                                    <span style="font-size: 11px; color: #d97706; font-weight: 600;">(Compound clause with mixed polarity)</span>
                                }
                            </td>
                            <td>
                                <span class="pill @item.Sentiment.ToLowerInvariant()">
                                    @item.Sentiment
                                </span>
                            </td>
                            <td>@(Math.Round(item.Confidence * 100))%</td>
                            <td>
                                <span class="emotion-tag">@item.PrimaryEmotion</span>
                            </td>
                            <td>
                                @if (item.AspectResults.Any())
                                {
                                    @foreach (var asp in item.AspectResults)
                                    {
                                        <span class="aspect-badge @asp.Sentiment.ToLowerInvariant()">
                                            @asp.Aspect: @asp.Sentiment
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span style="color: #94a3b8; font-size: 11px;">General</span>
                                }
                            </td>
                            <td style="white-space: nowrap; color: #64748b; font-size: 12px;">
                                @item.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <div style="display: inline-flex; gap: 6px;">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" style="padding: 4px 8px;">
                                        Inspect
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display: inline;" 
                                          onsubmit="return confirm('Are you sure you want to delete feedback #@item.Id by @item.UserName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" style="padding: 4px 8px;">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="pagination">
            <div style="font-size: 13px; color: #64748b;">
                Showing page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong> (@Model.TotalItems comments)
            </div>
            <div style="display: flex; gap: 6px;">
                @if (Model.HasPreviousPage)
                {
                    <a asp-action="History" 
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-sentimentFilter="@Model.SentimentFilter"
                       asp-route-aspectFilter="@Model.AspectFilter"
                       asp-route-dateRangeFilter="@Model.DateRangeFilter"
                       asp-route-sortOrder="@Model.SortOrder"
                       class="btn btn-secondary btn-sm">
                        &laquo; Previous
                    </a>
                }

                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    if (p == Model.CurrentPage)
                    {
                        <span class="btn btn-primary btn-sm" style="cursor: default;">@p</span>
                    }
                    else if (p <= 3 || p > Model.TotalPages - 2 || Math.Abs(p - Model.CurrentPage) <= 1)
                    {
                        <a asp-action="History" 
                           asp-route-page="@p"
                           asp-route-searchQuery="@Model.SearchQuery"
                           asp-route-sentimentFilter="@Model.SentimentFilter"
                           asp-route-aspectFilter="@Model.AspectFilter"
                           asp-route-dateRangeFilter="@Model.DateRangeFilter"
                           asp-route-sortOrder="@Model.SortOrder"
                           class="btn btn-secondary btn-sm">
                            @p
                        </a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a asp-action="History" 
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-sentimentFilter="@Model.SentimentFilter"
                       asp-route-aspectFilter="@Model.AspectFilter"
                       asp-route-dateRangeFilter="@Model.DateRangeFilter"
                       asp-route-sortOrder="@Model.SortOrder"
                       class="btn btn-secondary btn-sm">
                        Next &raquo;
                    </a>
                }
            </div>
        </div>
    }
</div>
