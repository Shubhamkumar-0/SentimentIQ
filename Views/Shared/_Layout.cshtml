<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Consultation Sentiment Intelligence</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Chart.js for enterprise interactive analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>
    <div class="app-layout">
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar">
            <div class="sidebar-header">
                <a class="sidebar-brand" asp-controller="Comments" asp-action="Index">
                    <div class="brand-icon">AI</div>
                    <div class="brand-info">
                        <h2>SentimentIQ</h2>
                        <span>Consultation Module</span>
                    </div>
                </a>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">Analytics</div>
                <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                   asp-controller="Comments" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                    Dashboard Overview
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ModelEvaluation" ? "active" : "")" 
                   asp-controller="Comments" asp-action="ModelEvaluation">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    ML.NET & Model Eval
                </a>

                <div class="nav-section-title" style="margin-top: 14px;">Feedback Operations</div>
                <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active" : "")" 
                   asp-controller="Comments" asp-action="History">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    Feedback Repository
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" 
                   asp-controller="Comments" asp-action="Create">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                    Submit New Feedback
                </a>
            </nav>

            <div class="sidebar-footer">
                <div style="margin-bottom: 8px;">
                    <span class="model-pill">ML.NET SDCA Active</span>
                </div>
                <div>B.Tech Final Year Project</div>
                <div style="font-size: 10px; color: #64748b; margin-top: 2px;">ASP.NET Core .NET 8 & ML.NET</div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="app-main">
            <!-- Top Navigation Bar -->
            <header class="app-topbar">
                <div class="topbar-title">
                    <h1>@ViewData["Title"]</h1>
                    <p>Consultation Feedback Intelligence & Aspect Analysis System</p>
                </div>
                <div class="topbar-actions">
                    <span class="badge-connected">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                        Database Connected
                    </span>
                    <a class="btn btn-primary btn-sm" asp-controller="Comments" asp-action="Create">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Add Feedback
                    </a>
                </div>
            </header>

            <!-- Page Content -->
            <main class="app-content">
                @if (TempData["SuccessMessage"] is string msg)
                {
                    <div class="alert alert-success">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        <span>@msg</span>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="app-footer">
                <div>
                    <strong>Sentiment Analysis of Comments Received Through Consultation Module</strong>
                </div>
                <div>
                    Stack: C# · ASP.NET Core MVC 8 · Entity Framework Core · SQL Server LocalDB · ML.NET · Chart.js
                </div>
            </footer>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
